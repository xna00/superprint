{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "src",
    "lib": ["ESNext"],
    "types": ["quickwin"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
  },
  // 本项目 lib 只有 ESNext（无 DOM）。src/api.ts 的 `import ... from 'api'` 会把 ../api/index.ts
  // 拉进本程序，那里用裸 `Request`/`Response`——这两个全局由 quickwin/lib/http-common.d.ts 的
  // `declare global` 提供，3.1.0 起 lib/fetch.d.ts 已 `import './http-common.js'`，会顺带进来。
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": []
}
